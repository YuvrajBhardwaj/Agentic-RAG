# LLM configuration (Groq is the default backend in app/main.py)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# Optional legacy path (demo.py / gemini_client only)
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.0-flash

# RAG data storage
RAG_DATA_DIR=data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Production hardening (see PRODUCTION_CHECKLIST.md) ----
# Require X-API-Key header on all routes except /health and /docs
# RAG_API_KEY=your_long_random_service_key_here
# Comma-separated list; defaults to localhost only when RAG_API_KEY is set
# ALLOWED_ORIGINS=https://your-frontend.com,https://webdev-uv.netlify.app
# Simple per-IP rate limit (req/min)
# RATE_LIMIT_PER_MIN=60
